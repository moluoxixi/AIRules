{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": false
  },
  "include": [
    "constants/**/*.ts",
    "roles/*/constants/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    ".git",
    "coverage",
    "dist",
    "node_modules",
    "**/__test__/**",
    "vendor"
  ]
}
