# Copy to ~/.config/airules/hindsight/hindsight.env and configure your model.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=

# Optional API base URL for your provider. For Ollama running on the Docker
# Desktop host, set provider=ollama, your installed model, and
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
HINDSIGHT_API_LLM_BASE_URL=
