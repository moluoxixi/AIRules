{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moluoxixi.dev/airules/change-unit.schema.json",
  "title": "AIRules Change Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "change",
    "change_unit_id",
    "title",
    "state",
    "revision",
    "created_at",
    "updated_at",
    "last_event_sequence",
    "failure_counts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "change": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "change_unit_id": { "type": "string", "pattern": "^CU-[a-z0-9][a-z0-9-]{0,62}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "state": {
      "enum": [
        "intake",
        "spec-ready",
        "plan-ready",
        "test-ready",
        "implementing",
        "verifying",
        "review-ready",
        "release-ready",
        "learning",
        "done",
        "blocked"
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_event_sequence": { "type": "integer", "minimum": 1 },
    "failure_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    }
  }
}
