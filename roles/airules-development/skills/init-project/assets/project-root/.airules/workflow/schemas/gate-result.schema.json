{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moluoxixi.dev/airules/gate-result.schema.json",
  "title": "AIRules Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "change_unit_id",
    "gate",
    "status",
    "failure_class",
    "route_to",
    "evidence_refs",
    "retryable",
    "idempotency_key",
    "event_sequence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "change_unit_id": { "type": "string", "pattern": "^CU-" },
    "gate": {
      "enum": [
        "requirement",
        "architecture",
        "scenario-test",
        "execution",
        "implementation",
        "automated",
        "review",
        "release",
        "learning"
      ]
    },
    "status": { "enum": ["pass", "fail"] },
    "failure_class": { "type": ["string", "null"] },
    "route_to": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "retryable": { "type": "boolean" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "event_sequence": { "type": "integer", "minimum": 1 }
  }
}
