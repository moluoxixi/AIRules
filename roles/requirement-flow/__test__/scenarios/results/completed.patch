+        self.assertEqual(reopened["items"][0]["quantity"], 99)
+        reopened["items"][0]["quantity"] = 1
+        self.store.save(reopened, self.actor)
+        self.store.submit(new_id, self.actor)
+        submitted = self.store.read(new_id)
