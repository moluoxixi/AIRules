{
  "name": "@moluoxixi/airules-moluoxixi-role",
  "type": "module",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @moluoxixi/airules-moluoxixi-core build && pnpm --filter @moluoxixi/airules-moluoxixi-cli build",
    "test": "pnpm --filter @moluoxixi/airules-moluoxixi-core test && pnpm --filter @moluoxixi/airules-moluoxixi-cli test",
    "test:publish": "pnpm --filter @moluoxixi/airules-moluoxixi-core test:publish && pnpm --filter @moluoxixi/airules-moluoxixi-cli test:publish",
    "lint": "pnpm --filter @moluoxixi/airules-moluoxixi-core lint && pnpm --filter @moluoxixi/airules-moluoxixi-cli lint",
    "lint:publish": "pnpm --filter @moluoxixi/airules-moluoxixi-core lint:publish && pnpm --filter @moluoxixi/airules-moluoxixi-cli lint:publish",
    "typecheck": "pnpm --filter @moluoxixi/airules-moluoxixi-core typecheck && pnpm --filter @moluoxixi/airules-moluoxixi-cli typecheck",
    "release": "pnpm --filter @moluoxixi/airules-moluoxixi-cli release",
    "release:minor": "pnpm --filter @moluoxixi/airules-moluoxixi-cli release:minor",
    "release:major": "pnpm --filter @moluoxixi/airules-moluoxixi-cli release:major",
    "release:beta": "pnpm --filter @moluoxixi/airules-moluoxixi-cli release:beta",
    "release:rc": "pnpm --filter @moluoxixi/airules-moluoxixi-cli release:rc",
    "release:promote": "pnpm --filter @moluoxixi/airules-moluoxixi-cli release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan",
    "verify:publish": "pnpm run test:publish && pnpm run build && pnpm run typecheck && pnpm run lint:publish && node packages/cli/scripts/release-preflight.js verify-packed-cli",
    "verify:published": "node packages/cli/scripts/release-preflight.js verify-npm --package all",
    "publish:dry-run": "pnpm run verify:publish && pnpm --filter @moluoxixi/airules-moluoxixi-core publish --dry-run --no-git-checks --access public && pnpm --filter @moluoxixi/airules-moluoxixi-cli publish --dry-run --no-git-checks --access public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.23"
  }
}
