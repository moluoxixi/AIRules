{
  "name": "moluoxixi-ai-rules",
  "type": "module",
  "version": "0.1.0",
  "description": "Personal AI workflow distribution built on top of superpowers.",
  "license": "MIT",
  "repository": "https://github.com/moluoxixi/AIRules",
  "bin": {
    "airules": "./dist/scripts/cli.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "LICENSE",
    "README-zh.md",
    "README.md",
    "agents",
    "dist",
    "docs",
    "mcp",
    "rules",
    "scripts",
    "skills"
  ],
  "scripts": {
    "airules": "tsx scripts/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "husky",
    "prepack": "npm run build",
    "lint": "eslint --fix",
    "lint:check": "eslint .",
    "presync": "git pull && command -v pnpm >/dev/null 2>&1 || npm install -g pnpm && pnpm install",
    "setup": "tsx scripts/cli.ts sync",
    "sync": "tsx scripts/cli.ts sync --host all",
    "sync:update-lock": "tsx scripts/sync-vendors.ts --update-lock",
    "rules:install": "tsx scripts/cli.ts sync",
    "pretest": "npx tsx scripts/sync-vendors.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "delivery:verify": "node scripts/verify-delivery-control.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "verify:knowledge-sources": "node scripts/verify-knowledge-sources.mjs airules.knowledge.json",
    "verify:rules:self-sufficiency": "node scripts/verify-rule-self-sufficiency.mjs",
    "verify:changes": "node scripts/verify-change-packs.mjs",
    "verify:control:l2": "npm run rules:check && npm run delivery:verify && npm run verify:changes && npm run verify:rules:self-sufficiency && npm run verify:skills && npm run verify:knowledge-sources",
    "rules:build": "node scripts/assemble-baseline.mjs",
    "rules:check": "node scripts/assemble-baseline.mjs --check",
    "purity:assemble": "node scripts/purity/purity-check.mjs",
    "purity:check": "node scripts/purity/purity-check.mjs"
  },
  "dependencies": {
    "kleur": "4.1.5",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.2.0",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.4",
    "eslint": "10.2.1",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.4.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "lint-staged": {
    "*.{vue,jsx,tsx,js,ts,mjs}": [
      "eslint --fix"
    ]
  }
}
