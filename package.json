{
  "name": "moluoxixi-ai-rules",
  "type": "module",
  "version": "0.2.0",
  "description": "Remote AI role asset distribution for supported hosts.",
  "license": "MIT",
  "repository": "https://github.com/moluoxixi/AIRules",
  "exports": {
    "./core": {
      "types": "./dist/scripts/lib/core/index.d.ts",
      "import": "./dist/scripts/lib/core/index.js"
    },
    "./role-runtime": {
      "types": "./dist/scripts/lib/role-runtime.d.ts",
      "import": "./dist/scripts/lib/role-runtime.js"
    }
  },
  "bin": {
    "airules": "./dist/scripts/cli.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "LICENSE",
    "README-zh.md",
    "README.md",
    "dist",
    "docs",
    "roles/*/constants/**",
    "roles/*/role.yaml",
    "scripts"
  ],
  "scripts": {
    "airules": "tsx scripts/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "node scripts/clean-dist.mjs",
    "prepare": "husky",
    "prepack": "npm run build",
    "lint": "eslint --fix",
    "lint:check": "eslint .",
    "setup": "tsx scripts/cli.ts sync",
    "sync": "tsx scripts/cli.ts sync --host all",
    "sync:moluoxixi": "tsx scripts/cli.ts sync --host all --role moluoxixi",
    "sync:update-lock": "tsx scripts/sync-vendors.ts --update-lock",
    "rules:install": "tsx scripts/cli.ts sync",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "kleur": "4.1.5",
    "smol-toml": "^1.6.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.2.0",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.4",
    "ajv": "8.20.0",
    "eslint": "10.2.1",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.4.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "lint-staged": {
    "*.{vue,jsx,tsx,js,ts,mjs}": [
      "eslint --fix"
    ]
  }
}
