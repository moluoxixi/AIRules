{
  "name": "moluoxixi-ai-rules",
  "type": "module",
  "version": "0.1.0",
  "description": "Personal AI workflow distribution built on top of superpowers.",
  "license": "MIT",
  "repository": "https://github.com/moluoxixi/AIRules",
  "bin": {
    "airules": "./dist/scripts/cli.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "LICENSE",
    "README-zh.md",
    "README.md",
    "dist",
    "docs",
    "roles",
    "scripts"
  ],
  "scripts": {
    "airules": "tsx scripts/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "husky",
    "prepack": "npm run build",
    "lint": "eslint --fix",
    "lint:check": "eslint .",
    "presync": "git pull && command -v pnpm >/dev/null 2>&1 || npm install -g pnpm && pnpm install",
    "setup": "tsx scripts/cli.ts sync",
    "sync": "tsx scripts/cli.ts sync --host all",
    "sync:development": "tsx scripts/cli.ts sync --host all --role openspec-development",
    "sync:speckit-development": "tsx scripts/cli.ts sync --host all --role speckit-development",
    "sync:openspec-development": "tsx scripts/cli.ts sync --host all --role openspec-development",
    "sync:ecc-development": "tsx scripts/cli.ts sync --host all --role ecc-development",
    "sync:trellis-development": "tsx scripts/cli.ts sync --host all --role trellis-development",
    "sync:product": "tsx scripts/cli.ts sync --host all --role product",
    "sync:update-lock": "tsx scripts/sync-vendors.ts --update-lock",
    "rules:install": "tsx scripts/cli.ts sync",
    "rules:check": "tsx scripts/check-rules-consistency.ts",
    "candidates:review": "tsx scripts/review-candidates.ts",
    "memory:health": "tsx scripts/memory-health.ts",
    "verify:scenario-coverage": "node scripts/verify-scenario-coverage.mjs",
    "pretest": "npx tsx scripts/sync-vendors.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "kleur": "4.1.5",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.2.0",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.4",
    "eslint": "10.2.1",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.4.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "lint-staged": {
    "*.{vue,jsx,tsx,js,ts,mjs}": [
      "eslint --fix"
    ]
  }
}
